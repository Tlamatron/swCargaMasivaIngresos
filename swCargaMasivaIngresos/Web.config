<configuration>
  <connectionStrings configProtectionProvider="RsaProtectedConfigurationProvider">
    <EncryptedData Type="http://www.w3.org/2001/04/xmlenc#Element"
      xmlns="http://www.w3.org/2001/04/xmlenc#">
      <EncryptionMethod Algorithm="http://www.w3.org/2001/04/xmlenc#aes256-cbc" />
      <KeyInfo xmlns="http://www.w3.org/2000/09/xmldsig#">
        <EncryptedKey xmlns="http://www.w3.org/2001/04/xmlenc#">
          <EncryptionMethod Algorithm="http://www.w3.org/2001/04/xmlenc#rsa-oaep-mgf1p" />
          <KeyInfo xmlns="http://www.w3.org/2000/09/xmldsig#">
            <KeyName>Rsa Key</KeyName>
          </KeyInfo>
          <CipherData>
            <CipherValue></CipherValue>
          </CipherData>
        </EncryptedKey>
      </KeyInfo>
      <CipherData>
        <CipherValue></CipherValue>
      </CipherData>
    </EncryptedData>
  </connectionStrings>
  
  <appSettings file="Content\seguridad\Cors.config">
    <!-- Ambiente: Prod o Test o Local -->
    <add key="Ambiente" value="Local" />
    <!-- Datos de configuración Inicial -->
    <add key="NombAplicacion" value="swCargaMasivaIngresos" />
    <add key="MostrarMenuLateral" value="false" />
    <add key="VersionSistema" value="1" />
    <add key="Motor" value="1" />
    <add key="Sistema" value="1" />
    <add key="Subsistema" value="1" />
    <add key="AppId" value="1" />
    <!-- Configuración de correo -->
    <add key="CorreoRemitente" value="sistema.ingresos@puebla.gob.mx" />
    <add key="PwdRemitente" value="obnxutuqhbzkbiza" />
    <add key="HostRemitente" value="smtp.gmail.com" />
    <add key="CorreoDestinatario" value="tlamatini.ortiz@puebla.gob.mx" />
    <add key="CorreoDestinatarioC" value="isabel.rugerio@puebla.gob.mx" />
    <!-- Log -->
    <add key="LogServiceUrlProd" value="https://wsservicioslogs.puebla.gob.mx/api/log/write" />
    <add key="LogServiceUrlTest" value="http://172.21.20.34:8088/apiServiciosLogs/api/log/write" />
    <!-- validador JWT -->
    <add key="ValidaJwtServiceUrlProd" value="https://wsservicioslogs.puebla.gob.mx/api/wsLogs" />
    <add key="ValidaJwtServiceUrlTest" value="http://172.21.20.34:8088/apiServiciosLogs/api/wsLogs" />
    <!-- Catalogo de los municipios -->
    <add key="MunicipiosServiceUrlProd" value="https://wspredialingresos.puebla.gob.mx/api/wsLogs" />
    <add key="MunicipiosServiceUrlTest" value="http://172.21.20.34:8088/swPredialIngresos" />
    <!-- Imagen Institucional -->
    <add key="ApiImagenUrlProd" value="https://swImagenInstitucional.puebla.gob.mx/" />
    <add key="ApiImagenUrlTest" value="http://172.21.20.34:8088/swImagenInstitucional/" />

    <!-- Llave maestra de 256 bits (Mínimo 32 caracteres). Esta misma llave se la tienes que dar a los programadores de la Aplicación A para que firmen el token -->
    <add key="SsoSharedSecret" value="Puebla2026_CargaMasiva_S3cr3t_K3y_Sup3rS3gur4!#" />
    <!-- El nombre exacto de la aplicación externa que tiene permitido mandarnos gente -->
    <add key="SsoAppOrigenPermitida" value="PortalFinanzasEstatal" />
    
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
  </appSettings>
